{
  "framework": null,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "installCommand": "echo no-op",
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.qlarify.health" }], "destination": "https://qlarify.health/$1", "statusCode": 301 },

    { "source": "/insights/doctor-youtube-channel-how-to-start-grow-india", "destination": "/blog/doctor-youtube-channel-how-to-start-grow-india", "statusCode": 301 },
    { "source": "/insights/google-ads-for-hospitals-india", "destination": "/blog/google-ads-for-hospitals-india", "statusCode": 301 },
    { "source": "/insights/hospital-marketing-budget-allocation-india-2026", "destination": "/blog/hospital-marketing-budget-allocation-india-2026", "statusCode": 301 },
    { "source": "/insights/local-seo-for-hospitals-india", "destination": "/blog/local-seo-for-hospitals-india", "statusCode": 301 },
    { "source": "/insights/whatsapp-marketing-for-hospitals-india", "destination": "/blog/whatsapp-marketing-for-hospitals-india", "statusCode": 301 },

    { "source": "/insights", "destination": "/blog", "statusCode": 301 },
    { "source": "/services", "destination": "/", "statusCode": 301 },
    { "source": "/work", "destination": "/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
